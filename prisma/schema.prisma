generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SummaryPDF {
  id        String   @id @default(nanoid(5))
  createdAt DateTime @default(now())
  imageUrl  String
  pdfUrl    String
  pdfName   String

  sections Section[]
}

model Section {
  id       String @id @default(nanoid(5))
  type     String
  title    String
  summary  String
  position Int

  SummaryPDF   SummaryPDF @relation(fields: [summaryPDFId], references: [id])
  summaryPDFId String
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}
